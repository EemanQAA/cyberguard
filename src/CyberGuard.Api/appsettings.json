{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "CyberGuard",
    "Audience": "CyberGuard.Clients",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7001", "http://localhost:5001" ]
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
